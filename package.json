{
  "name": "withstand",
  "version": "0.0.29",
  "keywords": [
    "helpers",
    "lightweight",
    "tree-shaking",
    "typescript",
    "utilities",
    "utils"
  ],
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heleg/withstand.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "prepare": "lefthook install",
    "build": "bun run generate-exports && bun run check-types && tsdown",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "check-types": "tsc",
    "ts-check": "tsc # Just an alias",
    "generate-exports": "bun scripts/generate-exports.ts",
    "check-package": "publint",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.6.6",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "publint": "^0.3.25",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2"
  }
}
